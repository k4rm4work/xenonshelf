# Optional: everything here can also be set in the app, under Settings → Server.
# Values set here win and can't be changed in the app.

# IGDB keys from https://dev.twitch.tv/console/apps (see the README)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# A login for the whole app (password of 12 characters or more). Set both or neither;
# outside a trusted network use it only behind HTTPS or a VPN.
XENONSHELF_USER=
XENONSHELF_PASSWORD=
